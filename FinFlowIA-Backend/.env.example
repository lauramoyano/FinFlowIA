# App
APP_NAME=FinanceAI
DEBUG=false
SECRET_KEY=change-me-in-production-use-long-random-string
CORS_ORIGINS=["http://localhost:5173","https://app.financeai.com"]

# Database
DATABASE_URL=postgresql+asyncpg://financeai:local_password@localhost:5432/financeai
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# LLM
# Default provider is OpenAI (gpt-4o-mini) — cheapest to get started with.
# Set LLM_PROVIDER=anthropic to use Claude Haiku instead; whichever one you
# don't pick still works as an automatic fallback if you set its key too.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here
LLM_PROVIDER=openai
LLM_CACHE_TTL_SECONDS=3600

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# Observability
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
